# Runtime data, installations and retired files stay local; none of it is tracked.
/data/
/frameworks/
/trash/
/.venv*/
/scripts/benchmarks/output/

# Editor and tool state stays local.
/.zed/
/.coverage
*.lnk
# the private overlay repo for this host's harness profile; see harness/README.md
/harness/overlay/

# The graph plugin needs this name at its canonical path; it is a junction into scripts/state/cache.
/graphify-out/
scripts/config/strata/.strata-mcp/
scripts/config/strata/ram-budget-*.done
scripts/config/strata/*.log
scripts/config/strata/run-*.bat
