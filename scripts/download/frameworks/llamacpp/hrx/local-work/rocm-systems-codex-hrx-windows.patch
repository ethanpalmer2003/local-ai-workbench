diff --git a/projects/rocr-runtime/libhsakmt/src/dxg/openclose.cpp b/projects/rocr-runtime/libhsakmt/src/dxg/openclose.cpp
index 494768ece0..c64bf162e8 100644
--- a/projects/rocr-runtime/libhsakmt/src/dxg/openclose.cpp
+++ b/projects/rocr-runtime/libhsakmt/src/dxg/openclose.cpp
@@ -706,16 +706,6 @@ static HSAKMT_STATUS init_vars_from_env(void) {
     dxg_runtime->check_avail_sysram = (envvar[0] == '1' && envvar[1] == '\0');
   }
 
-  // Set default GPU node based on ROCR_VISIBLE_DEVICES. Extract the first numeric value
-  // from the environment variable and add 1 to convert to 1-indexed node ID.
-  if ((envvar = getenv("ROCR_VISIBLE_DEVICES")) != nullptr) {
-    std::string devices(envvar);
-    size_t first_num_pos = devices.find_first_of("0123456789");
-    if (first_num_pos != std::string::npos) {
-      dxg_runtime->default_node = std::stoi(devices.substr(first_num_pos));
-    }
-  }
-
   // Determine SVM (Shared Virtual Memory) API support. Enabled by default unless
   // HSA_USE_SVM is explicitly set to "0". Currently forced to false.
   envvar = getenv("HSA_USE_SVM");
diff --git a/projects/rocr-runtime/libhsakmt/src/dxg/topology.cpp b/projects/rocr-runtime/libhsakmt/src/dxg/topology.cpp
index b27f794e74..3ce42eb4c6 100644
--- a/projects/rocr-runtime/libhsakmt/src/dxg/topology.cpp
+++ b/projects/rocr-runtime/libhsakmt/src/dxg/topology.cpp
@@ -855,6 +855,13 @@ HSAKMT_STATUS topology_sysfs_get_system_props(HsaSystemProperties& props) {
   props.NumNodes = dxg_topology->num_sysfs_nodes;
   // Update default GPU node to account CPU nodes
   dxg_runtime->default_node = dxg_topology->numa_node_count_;
+  // Visible-device ordinals exclude CPU nodes; system memory must use the selected GPU.
+  if (const char* visible = getenv("ROCR_VISIBLE_DEVICES")) {
+    char* end = nullptr;
+    unsigned long ordinal = strtoul(visible, &end, 10);
+    if (end != visible && (*end == 0 || *end == ',') && ordinal < num_adapters)
+      dxg_runtime->default_node += ordinal;
+  }
 
   return HSAKMT_STATUS_SUCCESS;
 }
