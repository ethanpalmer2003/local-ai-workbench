   iree_slim_mutex_unlock(&queue->locks.completion_drain_mutex);
+  iree_hal_amdgpu_host_queue_validate_completion_epoch(queue, epoch_snapshot);
   return iree_hal_amdgpu_host_queue_run_post_drain_actions(queue);
 }
 
