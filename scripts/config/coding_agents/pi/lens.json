{
  "contextInjection": {
    "enabled": false
  },
  "ignore": [
    "data/**",
    "frameworks/**",
    "trash/**",
    ".venv/**",
    "scripts/state/**",
    "scripts/tests/output/**"
  ],
  "lsp": {
    "servers": {
      "pyright": {
        "extensions": [
          ".py",
          ".pyi"
        ],
        "command": [
          "node",
          "{AI_ROOT}/.venv/Lib/site-packages/basedpyright/dist/pyright-langserver.js",
          "--stdio"
        ]
      }
    }
  }
}
