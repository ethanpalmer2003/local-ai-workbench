+// Same-origin gateway bridge; absent when using stock llama-server directly.
+interface WorkspaceSpeechState {
+	ready: boolean;
+	recording: boolean;
+	speaking: boolean;
+	status: string;
+}
+interface Window {
+	WorkspaceSpeech?: {
+		bind(
+			onTranscript: (text: string) => Promise<void>,
+			onState: (state: WorkspaceSpeechState) => void
+		): () => void;
+		toggleCapture(): Promise<void>;
+		stop(): void;
+		configure(): Promise<void>;
+	};
+}
